{
  "name": "@gwa/gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The gateway: composes the store and aura subgraphs into one supergraph and serves it",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compose": "mesh-compose -c mesh.config.ts -o supergraph.graphql",
    "gateway": "hive-gateway supergraph supergraph.graphql --config-path gateway.config.ts --port 4000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@graphql-hive/gateway": "2.15.2",
    "@graphql-mesh/compose-cli": "1.8.4"
  }
}
