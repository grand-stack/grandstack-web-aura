{
  "name": "@gwa/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The web app: a mobile-friendly interface for the instances in the store, read through the gateway",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "codegen": "graphql-codegen --config codegen.ts",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "graphql": "16.14.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "urql": "5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.16.0",
    "vite": "8.3.5"
  }
}
