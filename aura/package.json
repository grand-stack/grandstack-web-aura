{
  "name": "@gwa/aura",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The aura subgraph: wraps the Aura REST API, syncs it into the store and applies confirmed changes",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../docs/aura_api_spec_v1-2.yaml -o src/generated/aura-api.d.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@apollo/subgraph": "2.14.4",
    "graphql": "16.14.2",
    "graphql-yoga": "6.0.1",
    "neo4j-driver": "6.2.0"
  },
  "devDependencies": {
    "@neo4j/graphql": "7.6.4",
    "openapi-typescript": "7.13.0"
  }
}
